{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    // esnext + resolveJsonModule: el catálogo estético se importa como JSON
    // con atributo de tipo (`with { type: 'json' }`), que es ESM estándar y
    // lo que Node y los navegadores modernos entienden sin build.
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["src/core/**/*.js", "src/data/**/*.js", "src/i18n/**/*.js"]
}
